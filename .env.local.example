# Copy to .env.local (gitignored) and fill in your keys.
# Never commit real keys — only this template (*.example) is tracked by git.
#
# ── Required ─────────────────────────────────────────────────────────────
#   GOOGLE_API_KEY  — Gemini SDK for triage / chat / summarize / brief / match
#                     + the gemini-embedding-001 (3072-d) RAG query embedding.
#                     Get one at https://aistudio.google.com/apikey
#   GEMINI_MODEL    — Which Gemini model to call. We use 2.5-flash for cost.
#                     Other options: gemini-2.5-pro, gemini-2.5-flash-lite

GOOGLE_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.5-flash

# ── Database (optional — Neon Postgres + pgvector) ───────────────────────
#   The app reads DATABASE_URL (falling back to POSTGRES_URL). With either set,
#   ML outputs / symptom KB / embeddings / cohorts are served from Postgres and
#   `pnpm db:seed` populates it. Leave both unset and the app runs entirely on
#   the bundled JSON fallback — no database required.
#
#   On Vercel, the Neon Marketplace integration injects the full set below
#   automatically; pull them locally with `vercel env pull .env.local`.

DATABASE_URL=
# POSTGRES_URL=           # accepted as an alias if DATABASE_URL is unset
# Auto-injected by Vercel / `vercel env pull` (do not hand-edit):
#   DATABASE_URL_UNPOOLED, POSTGRES_URL_NON_POOLING, POSTGRES_PRISMA_URL,
#   PGHOST, PGUSER, PGPASSWORD, PGDATABASE, NEON_PROJECT_ID, VERCEL_OIDC_TOKEN, …

# ── Optional ─────────────────────────────────────────────────────────────
#   GOOGLE_MAPS_API_KEY  — Reserved; UI does not call Maps in the demo.
#   TAVILY_API_KEY       — Reserved for RAG fallback web search; not on the
#                          critical demo path.

GOOGLE_MAPS_API_KEY=
TAVILY_API_KEY=
